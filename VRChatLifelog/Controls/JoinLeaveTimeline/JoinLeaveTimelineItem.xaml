<UserControl x:Class="VRChatLifelog.Controls.JoinLeaveTimeline.JoinLeaveTimelineItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VRChatLifelog.Controls.JoinLeaveTimeline"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="EventBorderStyle" TargetType="Border" d:DataContext="{d:DesignInstance local:TimelineEvent}">
            <!-- 常に適用 -->
            <Setter Property="Width" Value="5" />
            <Setter Property="DockPanel.Dock" Value="Left" />

            <!-- 状態に応じて切り替え -->
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Opacity" Value="1" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding ParticipationPhase}"
                             Value="{x:Static local:EParticipationPhase.BeforeJoin}">
                    <Setter Property="CornerRadius" Value="2" />
                    <Setter Property="Margin" Value="0,0,5,8" />
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ParticipationPhase}"
                             Value="{x:Static local:EParticipationPhase.AfterLeave}">
                    <Setter Property="CornerRadius" Value="2" />
                    <Setter Property="Margin" Value="0,8,5,0" />
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayerNameButtonStyle" TargetType="Button"
               d:DataContext="{d:DesignInstance local:TimelineEvent}">
            <Setter Property="Content" Value="{Binding History.PlayerName}" />
            <Setter Property="Tag" Value="{Binding}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <EventSetter Event="Click" Handler="OnItemClicked" />

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="Black" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="LightBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverlappedWithSelection}" Value="False">
                    <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverlappedWithSelection}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border x:Name="Line" Style="{StaticResource EventBorderStyle}" />
        <Button Style="{StaticResource PlayerNameButtonStyle}" />
    </DockPanel>
</UserControl>