<UserControl x:Class="VRChatLifelog.Controls.JoinLeaveTimeline.JoinLeaveTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VRChatLifelog.Controls.JoinLeaveTimeline"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <ItemsControl x:Name="TimelineItems">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:TimelineItem}">
                <DockPanel HorizontalAlignment="Stretch">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding FormattedTime}" Margin="0,0,5,0" Width="110"
                               TextAlignment="Right" />
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Join -->
                        <ItemsControl ItemsSource="{Binding JoinEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:JoinLeaveTimelineItem LineBrush="MediumSeaGreen"
                                                                 Click="OnTimelineEventClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Leave -->
                        <ItemsControl ItemsSource="{Binding LeaveEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:JoinLeaveTimelineItem LineBrush="IndianRed"
                                                                 Click="OnTimelineEventClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>

        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer>
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>